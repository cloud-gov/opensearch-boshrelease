#!/usr/bin/env bash

set -e -u

tar xzf logtash/logstash-9.5.6-linux-x86_64.tar.gz -C "${BOSH_INSTALL_TARGET}" --strip-components 1

# Logstash 9.5.6 ships its own bundled JDK (Temurin) under <install>/jdk.
# Use it for the plugin install step below instead of a separate openjdk
# package dependency, since the logstash launcher itself will prefer this
# same bundled JDK at runtime.
export JAVA_HOME="${BOSH_INSTALL_TARGET}/jdk"
export PATH="${BOSH_INSTALL_TARGET}/bin:${JAVA_HOME}/bin:${PATH}"

# Installs missing plugins
logstash-plugin install --no-verify "file://${PWD}/logstash/logstash-filter-alter-3.0.3.zip"
logstash-plugin install --no-verify "file://${PWD}/logstash/logstash-filter-translate-3.5.0.zip"
logstash-plugin install --no-verify "file://${PWD}/logstash/logstash-input-relp-3.0.4.zip"
logstash-plugin install --no-verify "file://${PWD}/logstash/logstash-input-syslog-3.7.1.zip"
logstash-plugin install --no-verify "file://${PWD}/logstash/logstash-input-tcp-7.0.1.zip"
logstash-plugin install --no-verify "file://${PWD}/logstash/logstash-output-syslog-3.0.5.zip"
logstash-plugin install --no-verify "file://${PWD}/logstash/logstash-output-opensearch-2.1.1.zip"
