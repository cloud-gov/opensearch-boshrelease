#!/bin/bash
# Use the JDK bundled with the logstash package itself (Temurin, shipped
# inside the logstash tarball) rather than a separate JDK package.
export JAVA_HOME=/var/vcap/packages/logstash/jdk
export LS_JAVA_HOME=$JAVA_HOME
export PATH=$JAVA_HOME/bin:$PATH

export JOB_NAME=archiver_syslog
export JOB_DIR=/var/vcap/jobs/$JOB_NAME

<% p("logstash.plugins").each do |plugin| %>
/var/vcap/packages/logstash/bin/logstash-plugin install \
  <%= plugin.except("name").map { |key, value| "--#{key}=#{value}" }.join(" ") %> \
  <%= plugin["name"] %>
<% end %>

if [ -d ${JOB_DIR}/config/ssl ]; then
	chown -R vcap:vcap ${JOB_DIR}/config/ssl
fi
