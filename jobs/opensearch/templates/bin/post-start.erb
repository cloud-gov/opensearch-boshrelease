#!/bin/bash -e

set -e
set -x

export JQ_PACKAGE_DIR=/var/vcap/packages/jq
export PATH=$JQ_PACKAGE_DIR/bin:$PATH

export JOB_NAME=opensearch
export JOB_DIR=/var/vcap/jobs/$JOB_NAME
export OPENSEARCH_PATH_CONF=${JOB_DIR}/config

wait_for_listening() {
  echo -n "=== Waiting <%= p("opensearch.health.connect_timeout") %>s for opensearch to accept connections..."
  elapsed=0
  until [ $elapsed -ge <%= p("opensearch.health.connect_timeout") %> ]
  do
    nc -4 -z -v localhost 9200 >/dev/null 2>&1 && break
    elapsed=$[$elapsed+<%= p("opensearch.health.connect_interval") %>]
    sleep <%= p("opensearch.health.connect_interval") %>
    echo -n .
  done

  if [ "$elapsed" -ge "<%= p("opensearch.health.connect_timeout") %>" ]; then
     echo "ERROR: Cannot connect to opensearch. Exiting..."
     exit 1
  fi
  echo "Done"
}

wait_for_greenstate() {
  out=$(mktemp health-XXXXXX)
  remaining=<%= p("opensearch.health.timeout") %>
  echo "=== Waiting for Green status from opensearch..."
  until [ "${remaining}" -le 0 ]; do
    <% if p("opensearch.node.allow_data") and not p("opensearch.node.allow_cluster_manager") %>
    curl -sw '\n%{http_code}' \
      --key ${JOB_DIR}/config/ssl/opensearch-admin.key \
      --cert ${JOB_DIR}/config/ssl/opensearch-admin.crt  \
      --cacert ${JOB_DIR}/config/ssl/opensearch.ca \
      https://localhost:9200/_cluster/health > ${out}
    <% else %>
    curl -sw '\n%{http_code}' \
      --key ${JOB_DIR}/config/ssl/opensearch-admin.key \
      --cert ${JOB_DIR}/config/ssl/opensearch-admin.crt  \
      --cacert ${JOB_DIR}/config/ssl/opensearch.ca \
      https://localhost:9200/_cluster/health?local=true > ${out}
    <% end %>
    body=$(cat ${out} | head -n -1)
    status=$(cat ${out} | tail -n 1)
    # echo "body: ${body}"
    echo -n "[${status}] "
    <% if p("opensearch.node.allow_data") and not p("opensearch.node.allow_cluster_manager") %>
    if [ ${status} = "200" ] && echo ${body} | grep '"status":"green"'; then
      echo "Done"
      break
    fi
    <% else %>
    if [ ${status} = "200" ]; then
      echo "Done"
      break
    fi
    <% end %>
    remaining=$((remaining-<%= p("opensearch.health.interval") %>))
    sleep <%= p("opensearch.health.interval") %>
  done

  rm ${out}

  if [ "${remaining}" -le 0 ]; then
    echo "Node failed to join the cluster"
    curl -sw '\n%{http_code}' \
      --key ${JOB_DIR}/config/ssl/opensearch-admin.key \
      --cert ${JOB_DIR}/config/ssl/opensearch-admin.crt  \
      --cacert ${JOB_DIR}/config/ssl/opensearch.ca \
      https://localhost:9200/_cluster/health > ${out}
    body=$(cat ${out} | head -n -1)
    status=$(cat ${out} | tail -n 1)
    if [ ${status} = "200" ] && echo ${body} | grep '"unassigned_shards":0'; then
      echo "unassigned_shards is 0"
    else 
      exit 1
    fi
  fi
}

<% if !p("opensearch.health.disable_post_start") %>
  wait_for_listening
  wait_for_greenstate
  wait_for_listening
<% else %>

echo "Disable post start script property is set to <%= p("opensearch.health.disable_post_start") %>. Skipping post-start..."

<% end %>

<% if_p("opensearch.node.ssl.private_key") do %>
  <% if p("opensearch.node.allow_data") %>
  wait_for_listening
  OS="/var/vcap/packages/opensearch"
  source /var/vcap/packages/openjdk-21/bosh/runtime.env
  ODS="${OS}/plugins/opensearch-security"
  CNF="/var/vcap/jobs/opensearch/config"
  
  # Use the same temp directory that was set earlier
  TEMP_DIR="/var/vcap/data/opensearch/temp"
  mkdir -p "${TEMP_DIR}"
  # BouncyCastle-FIPS mmaps a native probe lib with exec perms; /tmp is often noexec.
  export OPENSEARCH_JAVA_OPTS="-Djava.io.tmpdir=${TEMP_DIR} -Djna.tmpdir=${TEMP_DIR} -Djava.library.path=${TEMP_DIR} -Dorg.bouncycastle.native.tmpdir=${TEMP_DIR}"
  export TMPDIR=${TEMP_DIR}
  export TMP=${TEMP_DIR}
  export TEMP=${TEMP_DIR}

  export OPENDISTRO_SECURITY_ADMIN_ALLOW_MIXED_CLUSTER=true

  echo "=== Applying SSL config:"
  chmod +x ${ODS}/tools/securityadmin.sh

  set +e
  SA_OUT="$(OPENDISTRO_SECURITY_ADMIN_ALLOW_MIXED_CLUSTER=true \
    ${ODS}/tools/securityadmin.sh -cd $CNF/opensearch-security \
      -cacert ${CNF}/ssl/opensearch.ca \
      -cert ${CNF}/ssl/opensearch-admin.crt \
      -key ${CNF}/ssl/opensearch-admin.key \
      -icl -nhnv 2>&1)"
  SA_RC=$?
  set -e
  echo "${SA_OUT}"

  if [ ${SA_RC} -ne 0 ]; then
    is_mixed=false
    if echo "${SA_OUT}" | grep -q "It is not allowed to run securityadmin against a mixed cluster"; then
      is_mixed=true
    fi

    # A real upload failure prints this; if present, do not tolerate.
    upload_failed=false
    if echo "${SA_OUT}" | grep -q "ERR: cannot upload configuration"; then
      upload_failed=true
    fi

    # The broadcast timeout manifests as a configupdate reload failure.
    broadcast_timeout=false
    if echo "${SA_OUT}" | grep -qi "Timeout after .* while retrieving configuration"; then
      broadcast_timeout=true
    fi

    if [ "${is_mixed}" = "true" ] && [ "${upload_failed}" = "false" ] && [ "${broadcast_timeout}" = "true" ]; then
      echo "WARN: securityadmin config was persisted, but the configupdate broadcast timed out on older-version nodes during a mixed-cluster rolling upgrade. Tolerating (exit ${SA_RC}); the final node will re-run against a homogeneous cluster."
    else
      echo "ERR: securityadmin failed (exit ${SA_RC}) for a reason other than a mixed-cluster broadcast timeout. Aborting post-start."
      exit ${SA_RC}
    fi
  fi
  <% end %>
<% end %>

# Add credentials to keystore
$JOB_DIR/bin/add-keystore-credentials.sh