#!/bin/bash

set -e
set -x

export JOB_NAME=opensearch
export JOB_DIR=/var/vcap/jobs/$JOB_NAME
export OPENSEARCH_PATH_CONF=${JOB_DIR}/config

# SSL Certificate options
CA="--cacert ${OPENSEARCH_PATH_CONF}/ssl/opensearch.ca"
CERT="--cert ${OPENSEARCH_PATH_CONF}/ssl/opensearch-admin.crt"
KEY="--key ${OPENSEARCH_PATH_CONF}/ssl/opensearch-admin.key"
OPENSEARCH_URL="https://localhost:9200"

curl -X PUT \
  ${KEY} ${CERT} ${CA} \
  ${OPENSEARCH_URL}/_cluster/settings \
  -H 'Content-Type: application/json' \
  -d '{"persistent":{"search_backpressure":{"mode":"enforced"}}}'

<% if_p("opensearch.node.ssl.private_key") do %>
  <% if p("opensearch.node.allow_data") %>
  export OPENSEARCH_HOME=/var/vcap/packages/opensearch
  source /var/vcap/packages/openjdk-21/bosh/runtime.env
  # OpenSearch 3.9 (opensearch-project/security#6023) relocated the security
  # tools to ${OPENSEARCH_HOME}/bin/opensearch-security/ with the executable bit
  # preserved.
  SECURITYADMIN="${OPENSEARCH_HOME}/bin/opensearch-security/securityadmin.sh"
  if [ ! -f "${SECURITYADMIN}" ]; then
    SECURITYADMIN="${OPENSEARCH_HOME}/plugins/opensearch-security/tools/securityadmin.sh"
  fi

  # BouncyCastle-FIPS mmaps a native probe lib with exec perms; /tmp is often noexec.
  TEMP_DIR="<%= p('opensearch.temp_dir') %>"
  mkdir -p "${TEMP_DIR}"
  export JAVA_OPTS="-Djava.io.tmpdir=${TEMP_DIR} -Djna.tmpdir=${TEMP_DIR} -Djava.library.path=${TEMP_DIR}"

  echo "=== post-deploy: reconciling OpenSearch security config against the converged cluster"
  chmod +x "${SECURITYADMIN}"
  "${SECURITYADMIN}" -cd ${OPENSEARCH_PATH_CONF}/opensearch-security \
    -cacert ${OPENSEARCH_PATH_CONF}/ssl/opensearch.ca \
    -cert ${OPENSEARCH_PATH_CONF}/ssl/opensearch-admin.crt \
    -key ${OPENSEARCH_PATH_CONF}/ssl/opensearch-admin.key \
    -icl -nhnv
  <% end %>
<% end %>

<% if p('opensearch.repository.s3.enabled') %>
<% if_p('opensearch.repository.s3.region') do %>
# Run snapshot setup
${JOB_DIR}/bin/add-snapshot.sh
<% end %>
<% end %>
